# Streamlit Community Cloud root-level Secrets (never commit secrets.toml).
APP_ENV = "public_demo"
DEMO_LEGACY_FIXTURES = false
RAG_API_BASE_URL = "https://version-aware-rag-public-demo.onrender.com"
DEMO_RUNTIME_ROOT = "/tmp/version-aware-rag-ui"
DEMO_DATA_CLASSIFICATION = "Official Public"
DEMO_REQUEST_TIMEOUT_SECONDS = 45
RAG_RETRY_LIMIT = 2
MAX_LLM_CALLS_PER_SESSION = 3
# Online generation is configured only on Render with RD_V2_ALLOW_EXTERNAL_GENERATION=true
# and DASHSCOPE_API_KEY. Never place that key in Streamlit Secrets or Git.
