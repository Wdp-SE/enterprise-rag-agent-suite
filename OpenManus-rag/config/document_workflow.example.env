# External version-aware RAG service
RAG_BASE_URL=http://127.0.0.1:8765

# Bounded retrieval and workflow execution
DOCUMENT_WORKFLOW_RAG_TIMEOUT_SECONDS=30
DOCUMENT_WORKFLOW_RAG_RETRY_LIMIT=1
DOCUMENT_WORKFLOW_RAG_TOP_K=5
DOCUMENT_WORKFLOW_MAX_WORKFLOW_STEPS=80
DOCUMENT_WORKFLOW_MAX_SECTION_STEPS=20
DOCUMENT_WORKFLOW_EXECUTION_BUDGET=60
DOCUMENT_WORKFLOW_WORKFLOW_TIMEOUT_SECONDS=180

# Safe default. GENERATIVE requires synthetic/public/approved-redacted data or a local model.
DOCUMENT_WORKFLOW_DRAFTING_MODE=EXTRACTIVE
DOCUMENT_WORKFLOW_DATA_CLASSIFICATION=synthetic

