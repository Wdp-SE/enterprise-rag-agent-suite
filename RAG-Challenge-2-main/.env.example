# Copy this file to .env and fill only the providers you use.
# Never commit .env, env, API keys, tokens, passwords, or terminal transcripts.

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
JINA_API_KEY=
IBM_API_KEY=

# Frozen R&D V2 runtime. Keep external generation false for private corpora.
RD_V2_ARTIFACT_ROOT=data/rd_v2_corpus/retrieval_artifacts/rd-v2-retrieval-final-v1.0
RD_V2_EMBEDDING_MODEL_SNAPSHOT=
RD_V2_DENSE_TOP_K=20
RD_V2_FINAL_TOP_K=5
RD_V2_CONTEXT_BUDGET=1800
RD_V2_NEIGHBOR_CHILDREN=1
RD_V2_TORCH_THREADS=1
RD_V2_MKLDNN_ENABLED=false
RD_V2_GENERATION_PROVIDER=dashscope
RD_V2_GENERATION_MODEL=qwen-turbo
RD_V2_ALLOW_EXTERNAL_GENERATION=false
RD_V2_TRUSTED_QA_MODE=ENFORCE
