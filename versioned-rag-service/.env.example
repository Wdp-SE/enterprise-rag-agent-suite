# Public Seeed reComputer Industrial / Jetson corpus (run from versioned-rag-service).
APP_ENV=public_demo
RAG_PUBLIC_CORPUS_ROOT=public_corpus_edge_ai
RAG_PUBLIC_RETRIEVAL_CONFIG=public_corpus_edge_ai/public_retrieval_runtime.json

# Optional generation; keys belong only in the RAG service environment.
RD_V2_ALLOW_EXTERNAL_GENERATION=false
RD_V2_GENERATION_PROVIDER=deepseek
RD_V2_GENERATION_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
