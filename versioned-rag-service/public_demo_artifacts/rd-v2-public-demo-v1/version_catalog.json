  "sections_by_version": {
    "public-a-api-v1": [
      {
        "section_id": "public-a-api-v1:section:001",
        "section_path": [
          "Case A 接口规范",
          "批处理接口"
        ],
        "content": "API-008 面向 REQ-023，POST /batches 同步返回处理结果。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "4b5cb55fb4202e18fdb0637b7d4c3cc5675cb7cec0ee78a4e49497a64415ea81"
      }
    ],
    "public-a-design-v1": [
      {
        "section_id": "public-a-design-v1:section:001",
        "section_path": [
          "Case A 系统设计说明书",
          "连接池设计"
        ],
        "content": "DES-014 面向 REQ-023，连接池按最大并发 500 配置，并在同步请求内返回结果。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "824a68409164105285dba27488f3ec10f2fc52256d2e0ff69262fc0703f6ae8c"
      }
    ],
    "public-a-req-v1": [
      {
        "section_id": "public-a-req-v1:section:001",
        "section_path": [
          "Case A 需求规格说明书",
          "容量与接口"
        ],
        "content": "REQ-023 支付批处理最大并发为 500，客户端通过同步接口等待结果。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "cdc90d6ed6dc75bc80b66157e9e0f1691e0973152f7045c1c2f1ee76a65de1f5"
      }
    ],
    "public-a-req-v2": [
      {
        "section_id": "public-a-req-v2:section:001",
        "section_path": [
          "Case A 需求规格说明书",
          "容量与接口"
        ],
        "content": "REQ-023 支付批处理最大并发调整为 1000，吞吐量目标为 200 MB/s，并改为异步任务接口。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "7cfb1017cbdd34fabc54c0f19ac9f87acdc85f5330dca506172a3c32a2db8481"
      }
    ],
    "public-a-runbook-v1": [
      {
        "section_id": "public-a-runbook-v1:section:001",
        "section_path": [
          "Case A 运维手册",
          "容量监控"
        ],
        "content": "OPS-006 监控批处理并发与同步接口超时率。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "b81c1be834ea6737fb998cfcf5e72b0e219f8351eecb7c7e3fb0305be0e17663"
      }
    ],
    "public-a-test-v1": [
      {
        "section_id": "public-a-test-v1:section:001",
        "section_path": [
          "Case A 测试用例",
          "容量验收"
        ],
        "content": "TC-102 验证 REQ-023，以 500 并发持续运行并检查错误率。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "6fcb36aec7f781f9385d56eb5c0631f6c9fa02f93b29213a25c89c6110ae6113"
      }
    ],
    "public-b-design-v1": [
      {
        "section_id": "public-b-design-v1:section:001",
        "section_path": [
          "Case B 系统设计说明书",
          "存储与归档设计"
        ],
        "content": "DES-031 面向 REQ-071，审计日志按日期分区，在线存储保留 7 天。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "8eedbcd9c346719d0357ed747b338d2d77fa59b3e6e2ae836ca29bba68abba8e"
      }
    ],
    "public-b-req-v1": [
      {
        "section_id": "public-b-req-v1:section:001",
        "section_path": [
          "Case B 需求规格说明书",
          "数据留存要求"
        ],
        "content": "REQ-071 审计日志在线可检索保存 7 天，超过周期后进入归档。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "e3ac3957a2106be7b24acd65a203d0c32387e4f939f5a256acfd5593565e8b49"
      }
    ],
    "public-b-req-v2": [
      {
        "section_id": "public-b-req-v2:section:001",
        "section_path": [
          "Case B 需求规格说明书",
          "数据留存要求"
        ],
        "content": "REQ-071 审计日志在线可检索保存周期调整为 30 天，第 31 天起进入归档。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "1449c6fbfa68c62177945196404c1a4fd80afa8e79f837ea6be95dbb7a8bda5e"
      }
    ],
