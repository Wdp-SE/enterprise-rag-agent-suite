      {
        "section_id": "public-b-runbook-v1:section:001",
        "section_path": [
          "Case B 运维手册",
          "存储容量巡检"
        ],
        "content": "OPS-031 每日检查在线日志分区容量与保存周期告警。",
        "page_start": 1,
        "page_end": 1,
        "content_hash": "6f5ac54e639777a2802adca1fa66c5a12ceca00bc21468abb8a344e72643e331"
      }
    ],
